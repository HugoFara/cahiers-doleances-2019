# DB CONNECTION
# Valeurs par défaut fonctionnelles avec `docker compose up -d` (voir compose.yaml).
# Pour la base distante du projet, demander les credentials à Ronan Sy.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cahier_doleances
DB_USER=cahier
DB_PASSWORD=mot-de-passe-local-a-changer

# S3 CONNEXION
# Laisser vide pour développer sans Object Storage : l'aperçu PDF de l'app Gradio
# retombe alors sur le dossier local data/raw/pdfs/.
S3_URL=
S3_REGION=
S3_ENDPOINT=
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
S3_BUCKET_NAME=

# DATA EXTRACTION
# Local path to the directory containing the PDF files to process.
PATH_TO_DATA=

# OCR (extraction/with_ocr)
# Backend mistral : clé de l'API OCR (console.mistral.ai), requise pour
# `--backend mistral`. Laisser vide pour n'utiliser que le backend ollama.
MISTRAL_API_KEY=
# Backend ollama : serveur d'inférence local (glm-ocr, qwen3-vl, ornith…).
OLLAMA_URL=http://localhost:11434
